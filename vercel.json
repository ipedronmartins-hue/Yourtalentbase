{
  "rewrites": [
    {
      "source": "/gondomar",
      "destination": "/ytb-clube-gestor.html?clube=gondomar"
    },
    {
      "source": "/gondomar/jogos",
      "destination": "/clube-publico.html?clube=gondomar"
    }
  ],
  "headers": [
    {
      "source": "/treinos/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
